#!/bin/sh
# commit-msg hook —— 校验提交信息格式（Conventional Commits）
# 规则见 scripts/check_commit_msg.py，CI 用同一个脚本，避免本地和线上两套标准。
# 临时绕过：git commit --no-verify

set -eu

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

ROOT="$(git rev-parse --show-toplevel)"
VALIDATOR="$ROOT/scripts/check_commit_msg.py"

for p in python python3; do
    if command -v "$p" >/dev/null 2>&1; then
        exec "$p" "$VALIDATOR" "$MSG_FILE"
    fi
done
if command -v py >/dev/null 2>&1; then
    exec py -3 "$VALIDATOR" "$MSG_FILE"
fi

echo "[commit-msg] 找不到 python，跳过格式检查" >&2
exit 0
