# 统一换行符，避免 Windows 上 checkout 出 CRLF 把 shell 钩子搞坏。
# .githooks/* 必须是 LF，否则 Git Bash 会报 "$'\r': command not found"。

* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.toml          text eol=lf
.githooks/*     text eol=lf

*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

*.png           binary
*.jpg           binary
*.wav           binary
*.iq            binary
